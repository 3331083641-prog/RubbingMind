{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "墨韵智考已审核馆藏清单 v3",
  "type": "array",
  "minItems": 28,
  "maxItems": 28,
  "items": {
    "type": "object",
    "required": ["id", "title", "dynasty", "originalYear", "rubbingPeriod", "artifactType", "scriptType", "author", "calligrapher", "originalLocation", "physicalCollectionInstitution", "rubbingCollectionInstitution", "collectionNumber", "sourceUrl", "license", "attribution", "imageAssets", "imageStatus", "sourceVerification", "description"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
      "dynasty": {"enum": ["东汉", "北魏", "唐代", "宋代", "元代", "明代", "清代"]},
      "originalYearCE": {"type": ["integer", "null"]},
      "originalLocation": {"type": ["string", "null"]},
      "physicalCollectionInstitution": {"type": ["string", "null"]},
      "license": {"enum": ["CC BY 4.0", "CC0", "Public Domain"]},
      "imageAssets": {
        "type": "object",
        "required": ["cover", "readable", "archive"],
        "properties": {"cover": {"type": "string"}, "readable": {"type": "string"}, "archive": {"type": "string"}}
      }
    }
  }
}

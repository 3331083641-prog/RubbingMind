  "findings": [
    {
      "claimId": "tang_01_duobao:date:dayCrossCheck",
      "work": "tang_01_duobao",
      "step1_transcriptionYearMonth": "释文：“天寳十一載（西元七五二年）。歲次壬辰。四月乙丑朔廿二日戊戍建”。年为天宝十一载，月为四月（不是闰月）。中研院查询结果：天寶11年歲次壬辰；该年有閏3月，没有閏4月，所以“四月”所指的月份没有歧义",
      "step2_newMoon": "中研院历表天寶11年4月一行：“4 丁丑 18 … 丁亥 28 … 丁酉 7 …”，即初一丁丑（西历5月18日）、十一日丁亥（5月28日）、廿一日丁酉（6月7日）；按此推，廿二日为戊戌，与单日查询“天寶11年4月22日 西元752年6月8日”对应（儒略历）",
      "threeWayClassification": {
        "ourCalculation": "不是我们算错：按释文“乙丑朔”往后推 21 天，22 日确为丙戌（乙丑=1，1+21=22，丙戌）。推算只是忠实套用了释文中的朔日",
        "inscriptionVsCalendar": "日干支“戊戌”与中研院历表相合（释文作“戊戍”，“戍/戌”字形相近）；朔日干支“乙丑”与历表的“丁丑”不合",
        "inscriptionOrTranscription": "待复核：“乙丑”是碑上原字（即碑文本身有误或另有所据），还是释文把“丁”误录为“乙”，需要人工对照拓本影像中“四月□丑朔”一处后才能判断；本轮不作结论"
      },
      "conclusion": "待复核",
      "fieldChanged": false,
      "suggestion": "人工核对拓本影像后再定：若影像为“丁丑”，属释文误录，可把 dayCrossCheck 改为一致；若影像为“乙丑”，则保持 conflict，并注明与中研院历表不合"
    },

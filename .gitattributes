# ==============================================================================
# 墨韵智考 (RubbingMind) - Git 属性与换行符规范
# ==============================================================================

# 默认文本文件自动规范换行符
* text=auto eol=lf

# 源码与配置文件
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows 批处理与 PowerShell 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制素材文件（防止跨平台 Git 破坏编码）
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary

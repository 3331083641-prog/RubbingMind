# ==============================================================================
# 墨韵智考 (RubbingMind) — 环境变量模板（RT-007）
# ------------------------------------------------------------------------------
# 本文件不会被自动 load_dotenv。请在 shell / 系统环境 / 启动脚本中 export / $env: 设置。
# 下列名称与仓库 Python 代码实际读取的键一致（见 glyph_inference / runtime_guard /
# runtime_paths / main / catalog_assessment）。
# ==============================================================================

# --- 部署模式与鉴权 ---
# local（默认）: loopback 写操作可无 token；remote: 敏感/写接口需管理员 Bearer token
RUBBINGMIND_DEPLOYMENT=local
RUBBINGMIND_ADMIN_TOKEN=
RUBBINGMIND_REVIEW_TOKEN=

# --- 视觉 / 多模态（可选；未配置时降级为本地推演）---
RUBBINGMIND_VISION_API_KEY=
RUBBINGMIND_VISION_BASE_URL=
RUBBINGMIND_VISION_MODEL=

# --- 数据路径覆盖（可选；不设则使用仓库默认相对路径）---
# RUBBINGMIND_DB_PATH=
# RUBBINGMIND_RUNTIME_DIR=
# RUBBINGMIND_UPLOAD_DIR=
# RUBBINGMIND_RESULTS_DIR=

# --- 读时计算护栏（可选）---
# RUBBINGMIND_COMPUTED_ON_READ_MAX_PIXELS=
# RUBBINGMIND_COMPUTED_ON_READ_MAX_BYTES=

# --- 浏览器脚本（可选）---
# RUBBINGMIND_FRONTEND_URL=
# RUBBINGMIND_DEV_URL=
# RUBBINGMIND_BROWSER_CHANNEL=
